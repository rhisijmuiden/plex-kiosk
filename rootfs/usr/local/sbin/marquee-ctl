#!/usr/bin/env bash
# Marquee control: backend for the web admin and the plex-kiosk helper.
#
#   marquee-ctl check                 JSON with available updates
#   marquee-ctl update [all|system|plex|marquee]
#   marquee-ctl channel main|test     switch production/test branch and reinstall
#   marquee-ctl noflix install|remove  optional NO-Flix app for the home screen
#   marquee-ctl restart-kiosk | reboot | poweroff
set -euo pipefail
# shellcheck disable=SC1091
. /etc/plex-kiosk/plex-kiosk.conf

DIR="${MARQUEE_DIR:-/opt/plex-kiosk}"
export DEBIAN_FRONTEND=noninteractive

branch() { git -C "$DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || cat /etc/plex-kiosk/branch 2>/dev/null || echo main; }

has_git() { git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1; }

json_str() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

check() {
  apt-get update -qq >/dev/null 2>&1 || true
  local debian plex marquee_behind="null" latest="null" err="null"
  debian="$(apt list --upgradable 2>/dev/null | grep -c '/' || true)"
  plex="$(flatpak remote-ls --system --updates flathub 2>/dev/null | grep -c . || true)"
  if has_git; then
    local b; b="$(branch)"
    if git -C "$DIR" fetch -q --depth 50 origin "$b" 2>/dev/null; then
      marquee_behind="$(git -C "$DIR" rev-list --count "HEAD..origin/$b" 2>/dev/null || echo 0)"
      latest="$(json_str "$(git -C "$DIR" show "origin/$b:VERSION" 2>/dev/null | tr -d '\n' || echo '?')")"
    else
      err="$(json_str "Could not reach the Marquee repository")"
    fi
  else
    err="$(json_str "Marquee is not installed from git; self-update unavailable")"
  fi
  printf '{"debian":%s,"flatpak":%s,"marquee_behind":%s,"marquee_latest":%s,"marquee_error":%s}\n' \
    "${debian:-0}" "${plex:-0}" "$marquee_behind" "$latest" "$err"
}

update_system() { echo "== Debian packages"; apt-get update; apt-get -y -o Dpkg::Options::=--force-confold full-upgrade; apt-get -y autoremove; }
update_plex()   { echo "== Plex and Flatpak runtimes"; /usr/local/sbin/plex-kiosk-update; }
update_marquee() {
  echo "== Marquee ($(branch))"
  has_git || { echo "Not a git checkout: $DIR"; return 1; }
  local b; b="$(branch)"
  git -C "$DIR" fetch --depth 50 origin "$b"
  git -C "$DIR" reset --hard "origin/$b"
  "$DIR/install.sh" --unattended
}

switch_channel() {
  local target="$1"
  [[ "$target" == "main" || "$target" == "test" ]] || { echo "Channel must be main or test"; exit 2; }
  has_git || { echo "Not a git checkout: $DIR"; exit 1; }
  echo "== Switching to $target"
  git -C "$DIR" fetch --depth 50 origin "+refs/heads/$target:refs/remotes/origin/$target"
  git -C "$DIR" checkout -B "$target" "origin/$target"
  "$DIR/install.sh" --unattended
}

# --- NO-Flix (optional app on the home screen) ---------------------------------
# The Linux app comes from the NO-Flix server's own download page (its GitHub
# repository is private): <server>/api/clients/download/linux, with a .sha256.
# It lives in the kiosk user's home so its in-app updater can replace it.
kiosk_home() { getent passwd "${KIOSK_USER:-kiosk}" | cut -d: -f6; }
noflix_dir() { echo "$(kiosk_home)/.local/share/noflix"; }

install_noflix() {
  local server="${NOFLIX_SERVER%/}" dir home tmp sum p
  [[ -n "$server" ]] || { echo "Enter the NO-Flix server address on the Home screen page first."; exit 2; }
  [[ "$server" =~ ^https?:// ]] || server="http://$server"
  home="$(kiosk_home)"; dir="$(noflix_dir)"
  [[ -n "$home" && -d "$home" ]] || { echo "Kiosk user ${KIOSK_USER:-kiosk} not found"; exit 1; }

  echo "== Libraries for NO-Flix (GTK, libmpv for playback, keyring for the sign-in)"
  apt-get update -qq || true
  local want=()
  for p in libgtk-3-0t64 libgtk-3-0 libmpv2 libsecret-1-0 gnome-keyring; do
    apt-cache show "$p" >/dev/null 2>&1 && want+=("$p")
  done
  apt-get install -y --no-install-recommends "${want[@]}"

  echo "== Downloading NO-Flix for Linux from $server"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  if ! curl -fSL --retry 2 --connect-timeout 10 -o "$tmp/noflix.tar.gz" "$server/api/clients/download/linux"; then
    echo "Download failed. Check the address, that the server is on, and that public downloads are"
    echo "switched on in the NO-Flix admin (Apps page)."
    exit 1
  fi
  sum="$(curl -fsSL --connect-timeout 10 "$server/api/clients/download/linux/sha256" 2>/dev/null | awk '{print $1}')" || sum=""
  if [[ -n "$sum" ]]; then
    echo "$sum  $tmp/noflix.tar.gz" | sha256sum -c -
  else
    echo "The server sent no checksum; skipping the check."
  fi
  mkdir "$tmp/x"
  tar -xzf "$tmp/noflix.tar.gz" -C "$tmp/x"
  [[ -x "$tmp/x/NO-Flix/noflix" ]] || { echo "Unexpected package: NO-Flix/noflix is missing"; exit 1; }

  echo "== Installing to $dir/NO-Flix"
  runuser -u "${KIOSK_USER:-kiosk}" -- mkdir -p "$dir"
  rm -rf "${dir:?}/NO-Flix.old"
  [[ -d "$dir/NO-Flix" ]] && mv "$dir/NO-Flix" "$dir/NO-Flix.old"
  mv "$tmp/x/NO-Flix" "$dir/NO-Flix"
  chown -R "${KIOSK_USER:-kiosk}:" "$dir/NO-Flix"
  rm -rf "${dir:?}/NO-Flix.old"

  # NO-Flix keeps its sign-in in the Secret Service (gnome-keyring). The kiosk
  # account has no password to unlock a keyring with, so it gets an
  # unencrypted one; otherwise a "choose a keyring password" dialog would
  # appear on the TV.
  local kr="$home/.local/share/keyrings"
  if [[ ! -e "$kr/login.keyring" ]]; then
    runuser -u "${KIOSK_USER:-kiosk}" -- mkdir -p "$kr"
    printf '[keyring]\ndisplay-name=login\nctime=0\nmtime=0\nlock-on-idle=false\nlock-after=false\n' > "$kr/login.keyring"
    echo login > "$kr/default"
    chown "${KIOSK_USER:-kiosk}:" "$kr/login.keyring" "$kr/default"
    chmod 0600 "$kr/login.keyring" "$kr/default"
  fi
  echo "== NO-Flix $(noflix_version) is installed. Switch it on under Home screen."
}

noflix_version() {
  sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$(noflix_dir)/NO-Flix/data/flutter_assets/version.json" 2>/dev/null || true
}

remove_noflix() {
  local dir; dir="$(noflix_dir)"
  echo "== Removing NO-Flix from $dir"
  rm -rf "${dir:?}/NO-Flix" "${dir:?}/NO-Flix.old"
  echo "== Done (its settings in the kiosk account are kept)"
}

case "${1:-}" in
  check) check ;;
  update)
    case "${2:-all}" in
      all) update_system; update_plex; update_marquee || true ;;
      system) update_system ;;
      plex) update_plex ;;
      marquee) update_marquee ;;
      *) echo "Unknown update target"; exit 2 ;;
    esac
    echo "== Done" ;;
  channel) switch_channel "${2:-}" ;;
  noflix)
    case "${2:-}" in
      install) install_noflix ;;
      remove) remove_noflix ;;
      *) echo "Usage: marquee-ctl noflix install|remove"; exit 2 ;;
    esac ;;
  restart-kiosk) systemctl restart plex-kiosk.service ;;
  reboot) systemctl reboot ;;
  poweroff) systemctl poweroff ;;
  *) sed -n '2,9p' "$0"; exit 2 ;;
esac
